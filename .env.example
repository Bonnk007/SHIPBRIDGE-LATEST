# Copy this to .env
# cp .env.example .env

# Your Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

PORT=3001
NODE_ENV=development

# Optional: comma-separated additional hosts Live Trigger is allowed to connect to.
# SAP BTP/CPI (*.hana.ondemand.com) and localhost are always allowed.
# ALLOWED_HOSTS=my-custom-host.example.com,other.example.com

# Optional: protect a public (e.g. Render) deployment. When set, every /api
# route except /api/health requires the header x-shipbridge-key with this
# value. The frontend prompts for it once and stores it in localStorage.
# Leave unset for local development (server is then open).
# APP_PASSWORD=choose-a-long-random-string

# Optional: verbose Real Trace fetch logging, for debugging a tenant's OData
# quirks (which endpoint shape it needs). Off by default — noisy in production.
# DEBUG_TRACE=1
